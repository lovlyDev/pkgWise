{
  "name": "@lovlydev/pkgwise-core",
  "version": "0.1.0-alpha.0",
  "description": "Core API for explainable JavaScript dependency analysis",
  "keywords": ["dependencies", "security", "npm", "osv", "typescript", "cli"],
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "LovlyDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovlyDev/pkgWise.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/lovlyDev/pkgWise#readme",
  "bugs": {
    "url": "https://github.com/lovlyDev/pkgWise/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/public/index.d.ts",
      "import": "./dist/public/index.js"
    }
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../node_modules/typescript/bin/tsc -p tsconfig.test.json && node --test .test-dist/test/**/*.test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
