{
  "name": "pkgwise-workspace",
  "version": "0.1.0-alpha.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovlyDev/pkgWise.git"
  },
  "homepage": "https://github.com/lovlyDev/pkgWise#readme",
  "bugs": {
    "url": "https://github.com/lovlyDev/pkgWise/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write \"packages/*/{src,test}/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \".changeset/*.json\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"packages/*/{src,test}/**/*.ts\" \"scripts/**/*.mjs\" \"*.json\" \".changeset/*.json\" \".github/**/*.yml\"",
    "lint": "node scripts/lint-source.mjs",
    "typecheck": "pnpm --filter @lovlydev/pkgwise-core build && pnpm --recursive typecheck",
    "test": "pnpm build && pnpm --recursive test",
    "verify:pack": "node scripts/verify-packages.mjs",
    "release:metadata": "node scripts/check-release-metadata.mjs",
    "release:version": "node scripts/check-release-version.mjs",
    "release:check": "pnpm check && pnpm verify:pack && pnpm release:metadata",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@types/node": "^24.0.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.0"
  }
}
